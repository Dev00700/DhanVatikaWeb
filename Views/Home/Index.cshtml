<div class="category2 sp2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 m-auto">
                <div class="heading1 text-center space-margin60">
                    <h5>Our Property Location</h5>
                    <div class="space16"></div>
                    <h2 class="text-anime-style-3">Select The Home That Suits You</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @if (Model != null)
            {
                foreach (var plot in Model.Locations)
                {
                   
                    <div class="col-lg-4 col-md-6" data-aos="zoom-in-up" data-aos-duration="800" style="cursor:pointer;" onclick="GetPlotData('@plot.LocationId')">
                        <div class="category-boxarea">
                         
                            <div class="img1">
                                <img src="@plot.Image" alt="@plot.LocationName">
                            </div>
                            <div class="text">
                                <a href="/PlotAvailblity?LocationId=@plot.LocationId">@plot.LocationName</a>
                                <div class="space16"></div>
                                <p>@plot.TotalPlot Properties</p>
                            </div>
                          
                        </div>
                    </div>
                }
            }
        </div>
    </div>
  </div>




