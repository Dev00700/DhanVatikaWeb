                    <div class="col-lg-6">
                    <div class="card mt-4" id="password">
                        <div class="card-header">
                            <h5>Change Password</h5>
                        </div>
                        <div class="card-body pt-0">
                            <label class="form-label">Current password</label>
                            <div class="form-group">
                                <input class="form-control" type="password" placeholder="Current password" id="txtoldpassword" />
                            </div>
                            <label class="form-label">New password</label>
                            <div class="form-group">
                                <input class="form-control" type="password" placeholder="New password" id="txtnewpasword" />
                            </div>
                            <label class="form-label">Confirm new password</label>
                            <div class="form-group">
                                <input class="form-control" type="password" placeholder="Confirm password" id="txtchangenewpassword" />
                            </div>

                            <div id="msg" class="mt-3 text-left fw-bold"></div>

                            <button class="btn bg-gradient-dark btn-sm float-end mt-2 mb-0" onclick="ChangePassword()">Update password</button>
                        </div>
                    </div>

                    </div>
                </div>
            </div>

        </div>
    </main>
    <script src="~/customer/assets/js/core/popper.min.js"></script>
    <script src="~/customer/assets/js/core/bootstrap.min.js"></script>
    <script src="~/customer/assets/js/plugins/smooth-scrollbar.min.js"></script>
    <script src="~/customer/assets/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="~/customer/assets/js/plugins/chartjs.min.js"></script>


    <script src="~/customer/assets/js/core/buttons.js"></script>
    <script src="~/customer/assets/js/soft-ui-dashboard.min9f1e.js"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script>
        function ChangePassword(){
            const oldPass = $("#txtoldpassword").val();
            const newPass = $("#txtnewpasword").val();
            const confirmPass = $("#txtchangenewpassword").val();

            if (!oldPass || !newPass || !confirmPass) {
                $("#msg").html('<span class="text-danger">All fields are required.</span>');
                return;
            }

               if (!checkPasswordMatch()) {
                $("#msg").html('<span class="text-danger">Passwords do not match.</span>');
                return;
            }

            var model = {
                OldPassword: oldPass,
                NewPassword: newPass,
                ConfirmPassword: confirmPass
            };

             $.ajax({
                url: '/ChangePassword/ChangePassword',
                type: 'POST',
                data: model,
                success: function (response) {
                    if (response.success) {
                        debugger;
                        if(response.success== true)
                        {
                            $("#msg").html('<span class="text-success">' + response.message + '</span>');
                        setTimeout(() => {
                            window.location.href = '/Login';
                        }, 2000);
                        }
                        else{
                            $("#msg").html('<span class="text-success">' + response.message + '</span>');
                        setTimeout(() => {
                            window.location.href = '/Login';
                        }, 2000);
                        }
                        
                    } else {
                        $("#msg").html('<span class="text-danger">' + response.message + '</span>');
                    }
                },
                error: function () {
                    $("#msg").html('<span class="text-danger">Error while changing password.</span>');
                }
            });
        }

        function checkPasswordMatch() {
              const newPass = $("#txtnewpasword").val();
            const confirmPass = $("#txtchangenewpassword").val();
            const matchMsg = $("#msg");

            if (confirmPass === "") {
                matchMsg.text("");
                return false;
            }

            if (newPass === confirmPass) {
                matchMsg.text("Passwords match ✔").css("color", "green");
                return true;
            } else {
                matchMsg.text("Passwords do not match ❌").css("color", "red");
                return false;
            }
        }
         $("#txtnewpasword").on("input", function () {
            checkPasswordMatch();
        });


         $(document).ready(function () {
               $("#txtchangenewpassword").on("input", function () {   checkPasswordMatch();});
         });


    </script>
