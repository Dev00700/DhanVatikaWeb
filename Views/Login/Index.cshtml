<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function Login(){

        var name = $("#txtname").val();
        var password= $("#txtpassword").val();
         $('#responseMessage').html("");


        if(name== null || name== undefined || name==""){
             $('#responseMessage')
              .html('<div class="alert alert-danger">Please enter user Name</div>');
            return false;
        }

        if(password == null || password== undefined || password== ""){
             $('#responseMessage')
              .html('<div class="alert alert-danger">Please enter Password</div>');
            return false;
        }
       
     
        var formData = {UserName: name,Password: password};

         $.ajax({
          url: '/Login/CustomerLogin', // adjust controller name if different
          type: 'POST',
          data: formData,
          success: function (response) {
            if (response.success) {
                
              $('#responseMessage')
                .html('<div class="alert alert-success">' + response.message + '</div>');
                 $("#txtname").val("");
         $("#txtpassword").val("");
           window.location.href = response.redirectUrl;
            } else {
              $('#responseMessage')
                .html('<div class="alert alert-danger">' + response.message + '</div>');
            }
          },
          error: function () {
            $('#responseMessage')
              .html('<div class="alert alert-danger">An error occurred while saving data.</div>');
          }
        });
    }
</script>