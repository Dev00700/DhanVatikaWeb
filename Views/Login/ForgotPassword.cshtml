@model DhanVatikaWeb.Models.ForgotPassword
@{
    Layout= null;
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', sans-serif;
    }

    body {
        height: 100vh;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .forgot-container {
        width: 100%;
        padding: 15px;
    }

    .forgot-card {
        max-width: 400px;
        margin: auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        text-align: center;
    }

        .forgot-card h2 {
            margin-bottom: 10px;
            color: #333;
        }

        .forgot-card p {
            font-size: 14px;
            color: #666;
            margin-bottom: 20px;
        }

    .input-group input {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        margin-bottom: 20px;
    }

        .input-group input:focus {
            border-color: #667eea;
            outline: none;
        }

    button {
        width: 100%;
        padding: 12px;
        background: #667eea;
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 15px;
        cursor: pointer;
        transition: background 0.3s;
    }

        button:hover {
            background: #5563d6;
        }

    .links {
        margin-top: 15px;
    }

        .links a {
            text-decoration: none;
            font-size: 13px;
            color: #667eea;
        }

            .links a:hover {
                text-decoration: underline;
            }

    button:disabled {
        background: #ccc;
        cursor: not-allowed;
    }


    .alert {
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
        font-size: 14px;
    }

    .alert-success {
        background: #e6fffa;
        color: #047857;
        border: 1px solid #34d399;
    }

    .alert-error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #f87171;
    }

</style>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DhanVatikaa Developers Pvt. Ltd.</title>
    <link rel="shortcut icon" href="assets/img/logo/preloader.png" type="image/x-icon">
</head>
<body>
    

    @using (Html.BeginForm("ForgotPassword", "Login", FormMethod.Post))
    {
    <div class="forgot-container">
        <div class="forgot-card">
                @if (ViewBag.Message != null)
                {
                    <div class="alert @(ViewBag.Flag == 1 ? "alert-success" : "alert-error")">
                        @ViewBag.Message
                    </div>
                }
            <h2>Forgot Password?</h2>
            <p>Enter your registered email address. We’ll send you a reset link.</p>


            <div class="input-group">
             @*    <input type="email" id="email" placeholder="Enter your email" required> *@
                    @Html.TextBoxFor(m => m.Email, new { @placeholder = "Enter your email", @required = "required" })
                <small id="emailMsg"></small>
            </div>

            <button type="submit" id="btnSubmit">Send Reset Link</button>

                <div class="links">
                    <a href="/Login">Back to Login</a>
                </div>
         
        </div>
    </div>
  }

</body>

</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script><script>
$(document).ready(function () {


            $("#Email").on("input", function () {
            var email = $(this).val();
            var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if (email === "") {
                $("#emailMsg").text("");
                $(this).css("border", "1px solid #ddd");
            }
            else if (emailPattern.test(email)) {
                $("#emailMsg").text("Valid email").css("color", "green");
                $(this).css("border", "1px solid green");
                      $("#btnSubmit").prop("disabled", false);
            }
            else {
                $("#emailMsg").text("Invalid email format").css("color", "red");
                $(this).css("border", "1px solid red");
                      $("#btnSubmit").prop("disabled", true);
            }
        });

});

    setTimeout(function () {
            document.querySelector('.alert')?.remove();
        }, 4000);
</script>
