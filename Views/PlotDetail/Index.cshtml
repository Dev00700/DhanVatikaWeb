<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script>
    function submitenquiry(plotId){
        if(plotId== null || plotId==0)
        {
           alert("plot not selected");
           return false;
        }

        var name = $("#txtname").val();
        var mobileno= $("#txtphoneno").val();
        var email= $("#txtemail").val();
        var messg= $("#txtmessage").val();
         $('#responseMessage').html("");
            

        if(name== null || name== undefined || name==""){
             $('#responseMessage')
              .html('<div class="alert alert-danger">Please enter Name</div>');
            return false;
        }
        if(mobileno == null || mobileno== undefined || mobileno== ""){
             $('#responseMessage')
              .html('<div class="alert alert-danger">Please enter Mobile No</div>');
            return false;
        }
        if(email == null || email== undefined || email ==""){
            $('#responseMessage')
              .html('<div class="alert alert-danger">Please enter email</div>');
            return false;
        }
        if(messg == null || messg== undefined || messg ==""){
              $('#responseMessage')
              .html('<div class="alert alert-danger">Please enter message</div>');
            return false;
        }

        var formData = {PlotId: plotId,Name: name, Mobile: mobileno, Email: email,  Remarks: messg};

         $.ajax({
          url: '/PlotDetail/SendEnquiry', // adjust controller name if different
          type: 'POST',
          data: formData,
          success: function (response) {
            if (response.success) {
              $('#responseMessage')
                .html('<div class="alert alert-success">' + response.message + '</div>');
                 $("#txtname").val("");
         $("#txtphoneno").val("");
       $("#txtemail").val("");
       $("#txtmessage").val("");// clear form
            } else {
              $('#responseMessage')
                .html('<div class="alert alert-danger">' + response.message + '</div>');
            }
          },
          error: function () {
            $('#responseMessage')
              .html('<div class="alert alert-danger">An error occurred while saving data.</div>');
          }
        });
    }
</script>
  <!--===== PROPERTY AREA ENDS =======-->
  <!--===== PROPERTY AREA STARTS =======-->
