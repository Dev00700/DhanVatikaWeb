        <div class="container-fluid py-4">

            <div class="row my-4">
                <div class="col-lg-12 col-md-12 mb-md-0 mb-4">
                    
                    @if(Model != null)
                    {
                        foreach (var data in Model)
                        {
                            <div class="card card-body" id="profile">
                                <div class="row justify-content-left align-items-center">
                                    <div class="col-sm-auto col-4">
                                        <div class="avatar avatar-xl position-relative">
                                            @if(data.PlotImage != null && data.PlotImage.Count() > 0)
                                            {
                                                <img src="@Model.Select(x => x.PlotImage[0].Image).FirstOrDefault()" class="w-100 border-radius-lg shadow-sm">
                                            }
                                            else
                                            {
                                                <img src="/assets/img/all-images/others/noimage.png" class="w-100 border-radius-lg shadow-sm">
                                            }
                                        </div>
                                    </div>
                                    <div class="col-sm-auto col-8 my-auto">
                                        <div class="h-100">
                                            <h5 class="mb-1 font-weight-bolder">
                                                @data.PlotName 
                                            </h5>
                                            <p class="mb-0 font-weight-bold text-sm">
                                               @data.Plot_Code
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="card mt-4" id="notifications">
                                <div class="card-header">
                                    <h5>Plot Detail</h5>
                                    <p class="text-sm">@data.Description</p>
                                </div>
                                <div class="card-body pt-0">
                                    <p class="text-sm font-weight-bold"> Size : @data.AreaSize @data.UnitTypeName</p>
                                    <p class="text-sm font-weight-bold"> Address : @data.Address </p>
                                    <p class="text-sm font-weight-bold"> Price : @data.Amount </p>
                                    <p class="text-sm font-weight-bold"> Facing : @data.Facing </p>
                                </div>
                            </div>

                            <div class="card mt-4" id="notifications">
                                <div class="card-header">
                                    <h5>Amenities Detail</h5>
                                </div>
                                <div class="card-body pt-0">
                                    <div class="table-responsive">
                                        <table class="table mb-0">
                                     
                                            <tbody>
                                                @if (!string.IsNullOrEmpty(data.Amenities))
                                                {
                                                    var amentiesdetails = System.Text.Json.JsonSerializer.Deserialize<List<AmentiesList>>(data.Amenities);
                                                    if (amentiesdetails.Any())
                                                    {
                                                        foreach(var ameneties in amentiesdetails)
                                                        {
                                                            <tr>
                                                                <td><a href="#"></a>
                                                                    @ameneties.amentyname
                                                                </td>
                                                                <td>
                                                                    @ameneties.amentydescr
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                           

                            <div class="card mt-4" id="installments">
                                <div class="card-header">
                                    <h5>Installments Detail</h5>
                                </div>
                                <div class="card-body pt-0">
                                    <div class="table-responsive">
                                        <table class="table mb-0 border">

                                            <thead>
                                              <tr>
                                                    <th>EMI No</th>
                                                    <th>EMI Date</th>
                                                    <th>Original Amount</th>
                                                    <th>Previous Due</th>
                                                    <th>Final Amount	</th>
                                                    <th>Paid  Amount</th>
                                                    <th>Due  Amount</th>
                                                    <th>Payment Type</th>
                                                    <th>Remarks</th>
                                                    <th>Status</th>
                                                    <th>Receipt</th>

                                              </tr>
                                            </thead>
                                            <tbody>
                                                @if (data.CustomerPlotPaymentList != null)
                                                {
                                                    foreach (var payments in data.CustomerPlotPaymentList)
                                                    {
                                                        <tr>
                                                            <td style="text-align:center">
                                                                @payments.EmiNo
                                                            </td>
                                                            <td style="text-align:center">
                                                                @payments.emidate.ToString("dd-MM-yyyy")
                                                            </td>
                                                            <td style="text-align:right">
                                                                @payments.amount
                                                            </td>
                                                            <td style="text-align:right">
                                                                @payments.PreviousDue
                                                            </td>

                                                            <td style="text-align:right">
                                                                @((payments.amount) + (payments.PreviousDue))
                                                            </td>

                                                            <td style="text-align:right">
                                                                @payments.paidamount
                                                            </td>

                                                            <td style="text-align:right">
                                                                @payments.DueAmount
                                                            </td>

                                                            <td style="text-align:center">
                                                                @payments.remarks
                                                            </td>

                                                            <td style="text-align:center">
                                                                @payments.NewRemarks
                                                            </td>
                                                            @if (payments.ispaid == true && payments.ReceiptFlag == true)
                                                            {
                                                                <td>
                                                                    <span class="badge bg-success">Success</span>
                                                                </td>
                                                            }

                                                            else if (payments.IsRejected == true)
                                                            {
                                                                <td>
                                                                    <span class="badge bg-warning">Rejected</span>
                                                                </td>
                                                            }

                                                            else if (payments.ispaid == true && payments.ReceiptFlag == false)
                                                            {
                                                                  <td>
                                                                    <span class="badge bg-dark">Pending For Approval</span>

                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td>
                                                                    <span class="badge bg-danger">Pending</span>
                                                                </td>
                                                            }

                                                            @if (payments.ispaid == true && payments.ReceiptFlag == true)
                                                            {
                                                                <td>
                                                                    <a href="/Dashboard/PaySlip?PlotId=@data.PlotId&CustomerPaymentId=@payments.customerpaymentid" target="_blank"> <span class="badge bg-primary">Print Receipt</span></a>
                                                                </td>
                                                            }


                                                            else if (payments.ispaid == true && payments.ReceiptFlag == false)
                                                            {
                                                                <td>
                                                                    <span class="badge bg-dark">Pending For Approval</span>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td>
                                                                    <span class="badge bg-danger">Pending</span>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </main>
