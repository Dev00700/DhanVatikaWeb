<script>
    function ChangePassword(){
        const oldPass = $("#txtoldpassword").val();
        const newPass = $("#txtnewpasword").val();
        const confirmPass = $("#txtchangenewpassword").val();

        // Basic validation
        if (!oldPass || !newPass || !confirmPass) {
            $("#msg").html('<span class="text-danger">All fields are required.</span>');
            return;
        }

           if (!checkPasswordMatch()) {
            $("#msg").html('<span class="text-danger">Passwords do not match.</span>');
            return;
        }

        var model = {
            OldPassword: oldPass,
            NewPassword: newPass,
            ConfirmPassword: confirmPass
        };

         $.ajax({
            url: '/CustomerProfile/ChangePassword',
            type: 'POST',
            data: model,
            success: function (response) {
                if (response.success) {
                    $("#msg").html('<span class="text-success">' + response.message + '</span>');
                    setTimeout(() => {
                        window.location.href = '/Login';
                    }, 2000);
                } else {
                    $("#msg").html('<span class="text-danger">' + response.message + '</span>');
                }
            },
            error: function () {
                $("#msg").html('<span class="text-danger">Error while changing password.</span>');
            }
        });
    }
  
    function checkPasswordMatch() {
          const newPass = $("#txtnewpasword").val();
        const confirmPass = $("#txtchangenewpassword").val();
        const matchMsg = $("#msg");

        if (confirmPass === "") {
            matchMsg.text("");
            return false;
        }

        if (newPass === confirmPass) {
            matchMsg.text("Passwords match ✔").css("color", "green");
            return true;
        } else {
            matchMsg.text("Passwords do not match ❌").css("color", "red");
            return false;
        }
    }
     $("#txtnewpasword").on("input", function () {
        checkPasswordMatch();
    });


     $(document).ready(function () {
           $("#txtchangenewpassword").on("input", function () {   checkPasswordMatch();});
     });

 
</script>